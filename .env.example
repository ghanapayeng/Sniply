# ==============================================================================
# SNIPLY ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Duplicate this file to .env for local development. DO NOT commit real secrets.
# ==============================================================================

# Application Environment (development, testing, production)
FLASK_ENV=development

# Application Secret Key (cryptographically random 64-char string for session cookies & CSRF)
# Generate using: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-minimum

# Database Connection String
# For Local Docker Dev: postgresql://sniply:sniplypassword@127.0.0.1:5432/sniply
# For Neon Production: postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/sniply?sslmode=require
DATABASE_URL=postgresql://sniply:sniplypassword@127.0.0.1:5433/sniply

# Redis Connection String (Cache-aside & URL caching)
# Local: redis://127.0.0.1:6379/0
# Upstash / Render Redis: rediss://default:password@host:6379
REDIS_URL=redis://127.0.0.1:6379/0

# Rate Limiting Storage URI (defaults to Redis or memory:// for tests)
RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0

# Application Public URLs
# BASE_URL: The public origin where short links are routed and redirected from
BASE_URL=http://localhost:5000

# FRONTEND_URL: The origin of the frontend web application
FRONTEND_URL=http://localhost:3000

# Allowed CORS Origins (comma-separated list without trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000

# Cookie & Session Security
SESSION_COOKIE_NAME=sniply_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_DAYS=14

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=300

# Visitor Privacy & Analytics
# Salt used for hashing IP addresses before persisting into click_events table
IP_HASH_SALT=replace-with-a-random-salt-string-for-visitor-privacy

# Shortening Expiration Policies
ANONYMOUS_MAX_EXPIRY_DAYS=30
DEFAULT_EXPIRY_DAYS=90

# Initial Administrator Bootstrap Credentials
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_EMAIL=admin@sniply.io
ADMIN_BOOTSTRAP_PASSWORD=SuperSecretAdminPass123!

# Local Docker Database Credentials (used by docker-compose)
POSTGRES_DB=sniply
POSTGRES_USER=sniply
POSTGRES_PASSWORD=sniplypassword

# Port binding
PORT=5000
